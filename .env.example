# Copier en .env : cp .env.example .env   (le .env n'est jamais commité)

# --- RustFS (data lake, API compatible S3) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_ENDPOINT=http://localhost:9100
LAKE_BUCKET=panier-vert

# --- PostgreSQL ---
POSTGRES_USER=panier
POSTGRES_PASSWORD=panier
POSTGRES_DB=panier_vert
POSTGRES_HOST=localhost
POSTGRES_PORT=5440